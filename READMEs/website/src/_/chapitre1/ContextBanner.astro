---
const challenges = [
  {
    icon: "delete",
    title: "Déchets Croissants",
    description: "La production mondiale de déchets augmente de façon exponentielle"
  },
  {
    icon: "eco",
    title: "Impact Environnemental",
    description: "Les méthodes traditionnelles de gestion des déchets polluent"
  },
  {
    icon: "location_city",
    title: "Défis Urbains",
    description: "Les villes manquent d'espace pour gérer leurs déchets"
  },
  {
    icon: "trending_up",
    title: "Coûts Élevés",
    description: "Les solutions actuelles sont souvent très coûteuses"
  }
];
---

<section class="relative py-20 overflow-hidden bg-gradient-to-br from-primary to-secondary">
  <!-- Parallax Effect -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[url('/images/I_justification/pattern.webp')] opacity-10 bg-repeat"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
      La Gestion des Déchets : Un Défi Global
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {challenges.map(challenge => (
        <div class="bg-white/10 backdrop-blur-sm p-6 rounded-lg border border-white/20 hover:bg-white/20 transition-colors duration-300">
          <span class="material-icons text-4xl text-white mb-4">
            {challenge.icon}
          </span>
          <h3 class="text-xl font-semibold text-white mb-2">
            {challenge.title}
          </h3>
          <p class="text-white/80">
            {challenge.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-lg text-white/90 max-w-3xl mx-auto leading-relaxed">
        Face à ces défis majeurs, la technologie BSF offre une solution innovante et durable,
        transformant les déchets organiques en ressources précieuses tout en réduisant notre impact environnemental.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    clip-path: polygon(0 0, 100% 2%, 100% 98%, 0 100%);
  }
</style>
