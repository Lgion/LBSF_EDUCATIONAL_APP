---
import ChapterLayout from '../layouts/ChapterLayout.astro';
import Introduction from '../components/chapitre1/Introduction.astro';
import PublicCible from '../components/chapitre1/PublicCible.astro';
import DiagrammeUnites from '../components/chapitre1/DiagrammeUnites.jsx';

const title = "Chapitre 1 : Justification";
const description = "Introduction générale au projet de gestion des déchets par les larves de mouches soldats noires (BSF) et justification de son importance.";
---

<ChapterLayout 
  title={title}
  description={description}
  chapterNumber={1}
>
  <div class="space-y-12">
    <Introduction />
    <PublicCible />
    <DiagrammeUnites client:load />

    <!-- Navigation vers le chapitre suivant -->
    <div class="flex justify-end mt-12">
      <a
        href="/chapitre2"
        class="inline-flex items-center px-6 py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors duration-200"
      >
        Chapitre suivant : Introduction BSF
        <span class="material-icons ml-2">arrow_forward</span>
      </a>
    </div>
  </div>
</ChapterLayout>
