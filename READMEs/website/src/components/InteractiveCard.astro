---
interface Props {
    title: string;
    icon: string;
    items: string[];
}

const { title, icon, items } = Astro.props;
---

<div class="interactive-card">
    <div class="card-header">
        <span class="icon">{icon}</span>
        <h3>{title}</h3>
    </div>
    <div class="card-content">
        <ul>
            {items.map(item => (
                <li class="fade-item">{item}</li>
            ))}
        </ul>
    </div>
</div>

<style lang="scss">
    .interactive-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;

        &:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);

            .fade-item {
                opacity: 1;
                transform: translateY(0);
            }
        }
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;

        .icon {
            font-size: 2rem;
        }

        h3 {
            margin: 0;
            color: var(--color-primary);
            font-size: 1.25rem;
        }
    }

    .card-content {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;

            li {
                margin: 0.5rem 0;
                padding-left: 1.5rem;
                position: relative;
                opacity: 0.8;
                transition: all 0.3s ease;

                &::before {
                    content: "•";
                    position: absolute;
                    left: 0;
                    color: var(--color-primary);
                }
            }
        }
    }

    .fade-item {
        opacity: 0.6;
        transform: translateY(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @media (max-width: 768px) {
        .interactive-card {
            padding: 1rem;
        }

        .card-header {
            .icon {
                font-size: 1.5rem;
            }

            h3 {
                font-size: 1.1rem;
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .interactive-card,
        .fade-item {
            transition: none;
        }
    }
</style>
