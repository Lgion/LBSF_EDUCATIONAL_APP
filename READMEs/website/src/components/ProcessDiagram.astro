// const { units } = Astro.props;
const units = [
    {
        name: "Unité d'élevage BSF",
        icon: "🪲",
        type: "rearing",
        steps: [
            "Maintien d'une population stable de larves S-DOL",
            "Élevage des larves jusqu'à la pupaison",
            "Gestion du cycle de reproduction",
        ],
    },
    {
        name: "Unité de conversion BSFL",
        icon: "♻️",
        type: "conversion",
        steps: [
            "Contrôle qualité des déchets reçus",
            "Préparation du substrat équilibré",
            "Bioconversion par les larves (70-80% humidité)",
            "Récolte des larves matures",
        ],
    },
    {
        name: "Unité de post-traitement",
        icon: "⚗️",
        type: "processing",
        steps: [
            "Séchage et transformation des larves",
            "Extraction de l'huile et production de farine",
            "Compostage ou digestion des résidus",
            "Contrôle qualité des produits finaux",
        ],
    },
];
---

<div class="process-diagram">
    <div class="process-flow">
        {
            units.map((unit, index) => (
                <div class="process-unit animate-in" data-unit={unit.type} style={`--delay: ${index * 0.5}s`}>
                    <div class="unit-header">
                        <span class="unit-icon">{unit.icon}</span>
                        <h3 class="unit-title">{unit.name}</h3>
                    </div>
                    <div class="unit-content">
                        {unit.steps.map((step, stepIndex) => (
                            <div class="step" style={`--step-delay: ${stepIndex * 0.2}s`}>
                                <span class="step-number">{stepIndex + 1}</span>
                                <p class="step-text">{step}</p>
                            </div>
                        ))}
                    </div>
                    {index < units.length - 1 && (
                        <div class="connector animate-pulse">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</div>

<style>
    .process-diagram {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
        overflow: hidden;
    }

    .process-flow {
        display: flex;
        flex-direction: column;
        gap: 2rem;

        @media (min-width: 768px) {
            flex-direction: row;
            align-items: flex-start;
            justify-content: space-between;
        }
    }

    .process-unit {
        flex: 1;
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        opacity: 0;
        transform: translateY(20px);
        animation: slideIn 0.5s ease-out forwards;
        animation-delay: var(--delay);
    }

    .unit-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .unit-icon {
        font-size: 2rem;
    }

    .unit-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-primary);
    }

    .unit-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .step {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        opacity: 0;
        animation: fadeIn 0.5s ease-out forwards;
        animation-delay: calc(var(--delay) + var(--step-delay));
    }

    .step-number {
        background: var(--color-primary);
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    .step-text {
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.4;
    }

    .connector {
        display: none;
        position: absolute;
        right: -1.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-primary);
        width: 3rem;
        height: 3rem;
        
        @media (min-width: 768px) {
            display: block;
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .process-unit,
        .step {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .animate-pulse {
            animation: none;
        }
    }
</style>

<script>
    // Add intersection observer for animation on scroll
    document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.style.animationPlayState = 'running';
                        const steps = entry.target.querySelectorAll('.step');
                        steps.forEach((step) => {
                            step.style.animationPlayState = 'running';
                        });
                    }
                });
            },
            {
                threshold: 0.2,
            }
        );

        document.querySelectorAll('.process-unit').forEach((unit) => {
            unit.style.animationPlayState = 'paused';
            const steps = unit.querySelectorAll('.step');
            steps.forEach((step) => {
                step.style.animationPlayState = 'paused';
            });
            observer.observe(unit);
        });
    });
</script>
