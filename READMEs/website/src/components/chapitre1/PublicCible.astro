---
---

<section class="mb-12">
  <div class="prose prose-lg max-w-none">
    <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
      Portée et public cible
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Échelle du projet -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-heading font-medium text-accent mb-4">
          Échelle du projet
        </h3>
        <div class="space-y-4">
          <div class="flex items-center">
            <span class="material-icons text-primary text-3xl mr-4">scale</span>
            <p class="text-gray-700">Capacité de traitement : <strong>5 tonnes/jour</strong></p>
          </div>
          <p class="text-gray-600">
            Cette échelle est optimale pour :
          </p>
          <ul class="list-disc pl-6 space-y-2 text-gray-600">
            <li>Une ville moyenne</li>
            <li>Un groupement d'entreprises</li>
            <li>Une zone industrielle</li>
          </ul>
        </div>
      </div>

      <!-- Public cible -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-heading font-medium text-accent mb-4">
          Public cible
        </h3>
        <div class="space-y-4">
          <div class="flex items-center">
            <span class="material-icons text-primary text-3xl mr-4">groups</span>
            <p class="text-gray-700">Formation adaptée aux professionnels</p>
          </div>
          <ul class="list-disc pl-6 space-y-2 text-gray-600">
            <li>Entrepreneurs en gestion des déchets</li>
            <li>Responsables environnementaux</li>
            <li>Techniciens de traitement</li>
            <li>Porteurs de projets innovants</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Prérequis -->
    <div class="mt-6 bg-white rounded-lg shadow-md p-6">
      <h3 class="text-xl font-heading font-medium text-accent mb-4">
        Niveau de connaissances requis
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 border border-gray-200 rounded-lg">
          <h4 class="font-medium text-primary mb-2">Technique</h4>
          <p class="text-sm text-gray-600">Bases en gestion de process industriels</p>
        </div>
        <div class="p-4 border border-gray-200 rounded-lg">
          <h4 class="font-medium text-primary mb-2">Gestion</h4>
          <p class="text-sm text-gray-600">Notions de gestion de projet</p>
        </div>
        <div class="p-4 border border-gray-200 rounded-lg">
          <h4 class="font-medium text-primary mb-2">Environnement</h4>
          <p class="text-sm text-gray-600">Sensibilité aux enjeux environnementaux</p>
        </div>
      </div>
    </div>
  </div>
</section>
