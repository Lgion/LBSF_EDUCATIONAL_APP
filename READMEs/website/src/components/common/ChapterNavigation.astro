---
interface Props {
  currentChapter: number;
}

const { currentChapter } = Astro.props;

const chapters = [
  {
    number: 1,
    title: 'BSF : Pourquoi et comment l\'utiliser',
    sections: ['Identité et objectifs', 'Public cible', 'Aspects techniques fondamentaux']
  },
  {
    number: 2,
    title: 'Déchets et collecte',
    sections: ['Types de déchets appropriés', 'Sources de collecte', 'Préparation des déchets']
  },
  {
    number: 3,
    title: 'Les trois unités de production',
    sections: ['Unité de reproduction', 'Unité de croissance larvaire', 'Unité de traitement post-récolte']
  },
  {
    number: 4,
    title: 'Scénarios de production',
    sections: ['Conditions requises', 'Scénarios de production', 'Analyse économique']
  },
  {
    number: 5,
    title: 'Conclusion',
    sections: ['Synthèse', 'Recommandations', 'Perspectives']
  }
];
---

<nav class="sticky top-24 bg-white rounded-card shadow-card p-4">
  <h2 class="text-lg font-heading font-semibold mb-4">Navigation du chapitre</h2>
  
  <div class="space-y-4">
    <!-- Navigation entre chapitres -->
    <div class="flex justify-between mb-6">
      {currentChapter > 1 && (
        <a
          href={`/chapter${currentChapter - 1}`}
          class="flex items-center text-sm text-primary hover:text-primary/80"
        >
          <span class="material-icons mr-1">arrow_back</span>
          Précédent
        </a>
      )}
      
      {currentChapter < 5 && (
        <a
          href={`/chapter${currentChapter + 1}`}
          class="flex items-center text-sm text-primary hover:text-primary/80"
        >
          Suivant
          <span class="material-icons ml-1">arrow_forward</span>
        </a>
      )}
    </div>

    <!-- Sections du chapitre actuel -->
    <div>
      <h3 class="font-medium mb-2">Dans ce chapitre :</h3>
      <ul class="space-y-2">
        {chapters[currentChapter - 1].sections.map((section, index) => (
          <li>
            <a
              href={`#section-${index + 1}`}
              class="block text-sm py-1 px-2 rounded hover:bg-primary/10 transition-colors duration-200"
            >
              {section}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style lang="scss">
  nav {
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }
</style>
