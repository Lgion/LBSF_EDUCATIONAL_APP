---
const currentYear = new Date().getFullYear();
---

<footer class="bg-secondary text-white">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Informations de contact -->
      <div>
        <h4 class="font-heading font-semibold mb-4">Contact</h4>
        <ul class="space-y-2">
          <li class="flex items-center">
            <span class="material-icons mr-2">email</span>
            <a href="mailto:contact@bsf-formation.fr" class="hover:text-success">
              contact@bsf-formation.fr
            </a>
          </li>
          <li class="flex items-center">
            <span class="material-icons mr-2">phone</span>
            <a href="tel:+33123456789" class="hover:text-success">
              +33 1 23 45 67 89
            </a>
          </li>
        </ul>
      </div>

      <!-- Navigation rapide -->
      <div>
        <h4 class="font-heading font-semibold mb-4">Navigation rapide</h4>
        <ul class="space-y-2">
          <li>
            <a href="/chapitre1" class="hover:text-success">Justification</a>
          </li>
          <li>
            <a href="/chapitre2" class="hover:text-success">Introduction BSF</a>
          </li>
          <li>
            <a href="/chapitre3" class="hover:text-success">Opérations</a>
          </li>
          <li>
            <a href="/chapitre4" class="hover:text-success">Post-traitement</a>
          </li>
        </ul>
      </div>

      <!-- Ressources -->
      <div>
        <h4 class="font-heading font-semibold mb-4">Ressources</h4>
        <ul class="space-y-2">
          <li>
            <a href="/documents/guide.pdf" class="hover:text-success">
              Guide complet (PDF)
            </a>
          </li>
          <li>
            <a href="/chapitre6" class="hover:text-success">
              Annexes et documents
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-white/20 text-center">
      <p>&copy; {currentYear} BSF Formation. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style lang="scss">
  footer {
    a {
      @apply transition-colors duration-200;
    }
  }
</style>
