---
import ChapterLayout from "../layouts/ChapterLayout.astro";
import "../styles/componentschapter1.scss";
import BSFPresentation from "../components/chapter1/BSFPresentation.astro";
import BenefitsChart from "../components/chapter1/BenefitsChart.astro";
import LifeCycleAnimation from "../components/chapter1/LifeCycleAnimation.astro";
import NaturalLifeCycleAnimation from "../components/chapter1/NaturalLifeCycleAnimation.astro";
import Natural from "../components/chapter1/Natural/App.tsx";
import Natural_ from "../components/chapter1/Natural_.astro";
import EngineeredLifecycle from "../components/chapter1/EngineeredLifecycle.astro";
import LifecycleViewer from "../components/chapter1/LifecycleViewer.jsx";
import AnimatedCounter from "../components/AnimatedCounter.astro";
import ProcessDiagram from "../components/ProcessDiagram.astro";
import Introduction from '../components/chapter1/Introduction.astro';
import PublicCible from '../components/chapter1/PublicCible.astro';

const title = "BSF : Pourquoi et comment l'utiliser";
const description =
  "Découvrez la technologie BSF, ses avantages environnementaux et économiques, ainsi que les aspects techniques fondamentaux pour sa mise en œuvre réussie.";
const pageTitle = "La Mouche Soldat Noire : Un Cycle de Vie Fascinant";
---

<ChapterLayout title={title} description={description} chapterNumber={1}>
  <div class="chapter1-container dark:bg-gray-900">
    <!-- Section 1.1 : Identité et objectifs -->
    <section id="section-1" class="content-card fade-in">
      <Introduction />

      <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
        La Mouche Soldat Noire
      </h2>
      <BSFPresentation />

      <section class="lifecycle-section">
        <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
          BSF: Cycle de Vie Naturel
        </h2>

        <div class="natural-lifecycle-container" style="width: 100%; max-width: 1200px; margin: 0 auto; padding: 20px 0;">
          <!-- <Natural client:load /> -->
          <Natural_ client:load />
        </div>
        <!-- <NaturalLifeCycleAnimation /> -->
        <!-- <LifeCycleAnimation client:load /> -->
        <EngineeredLifecycle client:load />

        <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
          BSF: Cycle De vie Ingéniérisé
        </h2>
        <LifecycleViewer client:load />
      </section>

      <!-- Industrial Process Section -->
      <section class="industrial-section">
        <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
          Process Industriel
        </h2>
        <ProcessDiagram />
      </section>
      <!-- Benefits Section -->

      <section>
        <!-- <h2 class="section-title"> -->
        <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
          Atouts de l'industrie BSFL
        </h2>
        <ol style="border:solid red;">
          <li>exemple indonésien</li>
          <li>public cible</li>
          <li>offre & objectifs de formation</li>
          <li>tarification des différents types de formation</li>
        </ol>

        <div class="highlight-box">
          <p class="font-medium">
            La technologie BSF (Black Soldier Fly) représente une solution
            innovante et durable pour la gestion des déchets organiques.
          </p>
        </div>

        <div class="objectives-grid">
          <div>
            <h3 class="subsection-title">Avantages environnementaux</h3>
            <ul class="info-list">
              <li>
                <u
                  >Réduction <strong><i>significative</i></strong> des <mark
                    >déchets organiques</mark
                  ></u
                >
              </li>
              <li>
                <strong>Production de <mark>compost</mark></strong> de <strong
                  ><u>haute qualité</u></strong
                >
              </li>
              <li><u>Diminution des émissions</u> de gaz à effet de serre</li>
              <li><strong><mark>Économie circulaire locale</mark></strong></li>
            </ul>
          </div>
          <div>
            <h3 class="subsection-title">Avantages économiques</h3>
            <ul class="info-list">
              <li>
                <strong>Production de <mark>protéines</mark></strong> à <strong
                  ><u>haute valeur ajoutée</u></strong
                >
              </li>
              <li>
                <u
                  >Réduction des <strong
                    >coûts de <mark>traitement des déchets</mark></strong
                  ></u
                >
              </li>
              <li><i>Valorisation</i> des <u>sous-produits</u></li>
              <li><strong><mark>Création d'emplois locaux</mark></strong></li>
              <li>
                <u
                  ><strong
                    ><mark>Énorme potentiel économique durable</mark></strong
                  ></u
                >
              </li>
            </ul>
          </div>
        </div>
      </section>


      <section class="benefits-section">
        <!-- <h2 class="text-2xl font-heading font-semibold text-secondary mb-6">
          Pourquoi Choisir la BSF?
        </h2> -->
        <div class="benefits-grid">
          <div class="benefit-card">
            <h3>Production 📈</h3>
            <AnimatedCounter value={35} suffix="%" label="protéines" />
            <AnimatedCounter value={30} suffix="%" label="matières grasses" />
            <p>Alternative durable aux farines de poisson</p>
          </div>
          <div class="benefit-card">
            <h3>Traitement ♻️</h3>
            <AnimatedCounter
              value={80}
              suffix="%"
              label="réduction des déchets"
            />
            <AnimatedCounter value={20} suffix="%" label="taux de conversion" />
            <p>Résidu utilisable comme compost</p>
          </div>
          <div class="benefit-card">
            <h3>Praticité 🛠️</h3>
            <ul>
              <li>Technologie simple</li>
              <li>Main d'œuvre locale</li>
              <li>Coûts limités</li>
            </ul>
          </div>
        </div>
      </section>

      <BenefitsChart />
    </section>

    <PublicCible />
    <!-- Section 1.2 : Public cible -->
    <section id="section-2" class="content-card fade-in">
      <h2 class="section-title">Public cible</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="tech-specs">
          <h3 class="subsection-title">Fermes rurales</h3>
          <ul class="info-list">
            <li>Gestion des déchets agricoles</li>
            <li>Production d'aliments pour animaux</li>
            <li>Autonomie en fertilisants</li>
          </ul>
        </div>
        <div class="tech-specs">
          <h3 class="subsection-title">Établissements urbains</h3>
          <ul class="info-list">
            <li>Hôtellerie et restauration</li>
            <li>Cantines collectives</li>
            <li>Marchés alimentaires</li>
          </ul>
        </div>
      </div>
      <textarea rows="10" style="width:100%;border:solid;" name="" id=""
      ></textarea>
    </section>

    <!-- Section 1.3 : Aspects techniques fondamentaux -->
    <section id="section-3" class="content-card fade-in">
      <h2 class="section-title">Aspects techniques fondamentaux</h2>

      <div class="space-y-6">
        <div>
          <h3 class="subsection-title">Principes de base</h3>
          <ul class="info-list">
            <li>Bioconversion des déchets organiques</li>
            <li>Cycle de développement des BSF</li>
            <li>Conditions environnementales optimales</li>
          </ul>
        </div>

        <div class="highlight-box">
          <h3 class="text-lg font-semibold mb-2">
            Paramètres clés de réussite
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p class="font-medium">Température</p>
              <p>27-30°C optimal</p>
            </div>
            <div>
              <p class="font-medium">Humidité</p>
              <p>60-70% recommandé</p>
            </div>
            <div>
              <p class="font-medium">Aération</p>
              <p>Ventilation contrôlée</p>
            </div>
            <div>
              <p class="font-medium">Substrat</p>
              <p>Qualité et composition adaptées</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation -->
    <div class="flex justify-between items-center mt-12">
      <a href="/" class="navigation-button">
        <span class="material-icons mr-2">arrow_back</span>
        Accueil
      </a>
      <a href="/chapter2" class="navigation-button">
        Chapitre 2 : Gestion des déchets
        <span class="material-icons ml-2">arrow_forward</span>
      </a>
    </div>
  </div>
</ChapterLayout>
