---
import ChapterLayout from '../layouts/ChapterLayout.astro';
import Modal from '../components/common/Modal.astro';
import '../styles/componentschapter3.scss';
import FormationCTA from '../components/common/FormationCTA.astro';


const title = "Les trois unités de production";
const description = "Description détaillée des trois unités essentielles de production BSF : reproduction, croissance larvaire et traitement post-récolte.";

const stages_reproduction = [
  {
    id: "fly-stage",
    title: "Stade mouche",
    description: `
      <div class="space-y-8">
        <div class="text-gray-700 mb-6">
          La gestion des mouches adultes est une étape cruciale qui nécessite une attention particulière et un suivi précis de 9 étapes clés.
        </div>

        <!-- Matériel nécessaire -->
        <div class="equipment-card bg-gray-50 p-4 rounded-lg">
          <iframe width="560" height="315" src="https://www.youtube.com/embed/HcfFoinWcs4" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <h4 class="font-semibold mb-2">Matériel requis :</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <img src="/images/III_unite/2_activites/3.2a.webp" alt="Matériel pour le stade mouche" class="rounded-lg shadow-md">
            <img src="/images/III_unite/2_activites/3.2a1.webp" alt="Matériel pour le stade mouche" class="rounded-lg shadow-md">
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h5 class="font-medium">Cages d'élevage :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Cage d'amour (10 000 mouches)</li>
                <li>Cage sombre d'émergence</li>
                <li>Support de cage</li>
                <li>Cadre mobile</li>
              </ul>
            </div>
            <div>
              <h5 class="font-medium">Matériel de ponte :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>"Eggies" (supports de ponte)</li>
                <li>Conteneur d'attractif</li>
                <li>Système d'hydratation</li>
                <li>Balance de précision</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="grid gap-6">
          <!-- Étape 1 -->
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4 class="step-title">Préparation de la cage d'amour</h4>
              <p>Accrocher une cage d'amour propre sur son support et mesurer son poids avec le support. Cette cage peut contenir jusqu'à 10 000 mouches.</p>
            </div>
          </div>

          <!-- Étape 2 -->
          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4 class="step-title">Installation et connexion</h4>
              <p>Fixer la cage sur le cadre mobile et la placer en face de la première cage sombre. Connecter les tunnels et allumer la lumière d'attraction.</p>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step2.webp" alt="Installation de la cage" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 3 -->
          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4 class="step-title">Cycle de transfert</h4>
              <p>Toutes les 30 minutes : déconnecter, fermer les tunnels, peser la cage, et répéter jusqu'à ce que la cage soit suffisamment remplie (les mouches couvrent les parois sans s'entasser au fond).</p>
            </div>
          </div>

          <!-- Étape 4 -->
          <div class="step-card">
            <div class="step-number">4</div>
            <div class="step-content">
              <h4 class="step-title">Finalisation du transfert</h4>
              <p>Déconnecter la cage d'amour, éteindre la lumière et déplacer la cage vers la table dédiée.</p>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step4.webp" alt="Pesée de la cage" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 5 -->
          <div class="step-card">
            <div class="step-number">5</div>
            <div class="step-content">
              <h4 class="step-title">Préparation de l'attractif</h4>
              <p>Mélanger :</p>
              <ul class="list-disc ml-6 mt-2">
                <li>100g de mouches mortes</li>
                <li>200g de résidus des conteneurs de nurserie</li>
                <li>200g de résidus de l'ancien conteneur d'attractif</li>
                <li>1L d'eau</li>
              </ul>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step5.webp" alt="Préparation de l'attractif" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 6 -->
          <div class="step-card">
            <div class="step-number">6</div>
            <div class="step-content">
              <h4 class="step-title">Préparation des supports de ponte</h4>
              <p>Préparer 10 "eggies" en alternant des feuilles de bois avec et sans punaises, maintenues par des élastiques.</p>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step6.webp" alt="Préparation des eggies" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 7 -->
          <div class="step-card">
            <div class="step-number">7</div>
            <div class="step-content">
              <h4 class="step-title">Système d'hydratation</h4>
              <p>Installer un conteneur d'eau avec un chiffon en coton passant par les fentes du couvercle pour assurer une hydratation continue.</p>
            </div>
          </div>

          <!-- Étape 8 -->
          <div class="step-card">
            <div class="step-number">8</div>
            <div class="step-content">
              <h4 class="step-title">Installation du système de ponte</h4>
              <p>Collecter 20 mouches pour échantillonnage, placer le conteneur d'attractif avec les "eggies" et le système d'hydratation.</p>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step8.webp" alt="Installation complète" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 9 -->
          <div class="step-card">
            <div class="step-number">9</div>
            <div class="step-content">
              <h4 class="step-title">Finalisation</h4>
              <p>Fermer la cage et ajouter une étiquette datée. S'assurer que les pieds de la table sont bien placés dans les pièges anti-fourmis.</p>
              <img src="/images/III_unite/2_activites/a_steps/3.2b_step9.webp" alt="Cage finale installée" class="step-image mt-3">
            </div>
          </div>
        </div>

        <div class="bg-yellow-50 p-4 rounded-lg mt-6">
          <h4 class="font-semibold text-yellow-800 mb-2">Points de surveillance importants :</h4>
          <ul class="list-disc ml-6 text-yellow-700">
            <li>Faire attention à la lumière d'attraction pour éviter les brûlures</li>
            <li>Porter une blouse de laboratoire et des gants en latex lors de la manipulation de l'attractif</li>
            <li>Peser la cage après chaque connexion pour suivre le taux d'émergence</li>
            <li>Maintenir une température de 25-30°C et une humidité de 60-70%</li>
          </ul>
        </div>
      </div>
    `
  },
  {
    id: "egg-stage",
    title: "Stade œuf",
    description: `
      <div class="space-y-8">
        <div class="text-gray-700 mb-6">
          La collecte et la gestion des œufs est une étape délicate qui s'effectue après 4 jours d'incubation. Une cage contenant 10 000 mouches peut produire environ 75 grammes d'œufs.
        </div>

        <!-- Matériel nécessaire -->
        <div class="equipment-card bg-gray-50 p-4 rounded-lg">
          <iframe width="560" height="315" src="https://www.youtube.com/embed/UR8mIbQtRak" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <h4 class="font-semibold mb-2">Matériel requis :</h4>
          <img src="/images/III_unite/2_activites/3.2b.webp" alt="Matériel pour le stade œuf" class="w-full rounded-lg shadow-md mt-2 mb-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h5 class="font-medium">Matériel de récolte :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Pinces pour gratter les œufs</li>
                <li>Bol de récupération</li>
                <li>Désinfectant (alcool 95%)</li>
                <li>Brosse pour nettoyage</li>
              </ul>
            </div>
            <div>
              <h5 class="font-medium">Matériel de stockage :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Conteneurs de stockage</li>
                <li>Système de codage couleur</li>
                <li>Balance de précision</li>
                <li>Fournitures de nettoyage</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="grid gap-6">
          <!-- Étape 1 -->
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4 class="step-title">Retrait des supports de ponte</h4>
              <p>Retirer les "eggies" de la cage d'amour après exactement 4 jours (4 x 24h) après l'installation initiale.</p>
              <img src="/images/III_unite/2_activites/b_steps/3.2b_step1.webp" alt="Retrait des eggies" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 2 -->
          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4 class="step-title">Gestion de l'attractif</h4>
              <p>Retirer l'ancien conteneur d'attractif. Conserver 200g de résidus pour le prochain lot et nettoyer le conteneur avec du détergent.</p>
            </div>
          </div>

          <!-- Étape 3 -->
          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4 class="step-title">Collecte des mouches mortes</h4>
              <p>Balayer les mouches mortes. Conserver 100g pour le prochain attractif et disposer du reste dans les déchets organiques.</p>
            </div>
          </div>

          <!-- Étape 4 -->
          <div class="step-card">
            <div class="step-number">4</div>
            <div class="step-content">
              <h4 class="step-title">Nettoyage de la cage</h4>
              <p>Retourner la cage, la secouer pour enlever les dernières mouches, puis la laver en machine à 30°C avec du détergent.</p>
              <img src="/images/III_unite/2_activites/b_steps/3.2b_step4.webp" alt="Nettoyage de la cage" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 5 -->
          <div class="step-card">
            <div class="step-number">5</div>
            <div class="step-content">
              <h4 class="step-title">Désinfection de l'espace</h4>
              <p>Nettoyer la table de la cage avec une solution d'alcool à 95% et retirer l'étiquette de date.</p>
            </div>
          </div>

          <!-- Étape 6 -->
          <div class="step-card">
            <div class="step-number">6</div>
            <div class="step-content">
              <h4 class="step-title">Gestion des supports d'œufs</h4>
              <p>Retirer les supports d'œufs âgés d'une semaine de la douche d'éclosion, identifiés par leur code couleur journalier.</p>
              <img src="/images/III_unite/2_activites/b_steps/3.2b_step6.webp" alt="Retrait des supports d'œufs" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 7 -->
          <div class="step-card">
            <div class="step-number">7</div>
            <div class="step-content">
              <h4 class="step-title">Récolte des œufs</h4>
              <p>Ouvrir délicatement les 10 "eggies" et gratter soigneusement les œufs des deux côtés de chaque feuille avec une pince. Collecter la masse d'œufs dans un bol.</p>
            </div>
          </div>

          <!-- Étape 8 -->
          <div class="step-card">
            <div class="step-number">8</div>
            <div class="step-content">
              <h4 class="step-title">Distribution des œufs</h4>
              <p>Peser la masse totale des œufs et la diviser en portions de 40g. Placer dans les supports et les suspendre dans la douche d'éclosion au-dessus des conteneurs.</p>
              <img src="/images/III_unite/2_activites/b_steps/3.2b_step8.webp" alt="Distribution des œufs" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 9 -->
          <div class="step-card">
            <div class="step-number">9</div>
            <div class="step-content">
              <h4 class="step-title">Préparation des conteneurs d'éclosion</h4>
              <p>Pour chaque conteneur :</p>
              <ul class="list-disc ml-6 mt-2">
                <li>Préparer 3kg de mélange (30% aliment poulet sec + 70% eau)</li>
                <li>Couvrir d'une couche de cocopeat ou son de blé (0.5-1.0 cm)</li>
                <li>Étiqueter avec le code date du jour</li>
              </ul>
              <img src="/images/III_unite/2_activites/b_steps/3.2b_step9.webp" alt="Préparation des conteneurs" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 10 -->
          <div class="step-card">
            <div class="step-number">10</div>
            <div class="step-content">
              <h4 class="step-title">Organisation des étagères</h4>
              <p>Descendre tous les conteneurs d'éclosion d'un niveau. Les conteneurs du bas contiendront des larves de 5 jours. Placer les nouveaux conteneurs sur l'étagère supérieure.</p>
            </div>
          </div>
        </div>

        <div class="bg-yellow-50 p-4 rounded-lg mt-6">
          <h4 class="font-semibold text-yellow-800 mb-2">Points de surveillance importants :</h4>
          <ul class="list-disc ml-6 text-yellow-700">
            <li>Porter un masque et des lunettes pour se protéger des œufs et des petites larves</li>
            <li>Utiliser une blouse de laboratoire et des gants en latex pour manipuler les "eggies", l'attractif et les mouches mortes</li>
            <li>Mesurer le poids des œufs récoltés</li>
            <li>Calculer le nombre d'œufs récoltés (1 œuf = 0.0000291 grammes)</li>
          </ul>
        </div>
      </div>
    `
  },
  {
    id: "hatchling-stage",
    title: "Stade éclosion",
    description: `
      <div class="space-y-8">
        <div class="text-gray-700 mb-6">
          À l'âge de 5 jours (5-DOL), les larves sont récoltées des conteneurs d'éclosion. À ce stade, un bac peut contenir environ 700 000 larves, soit 73 larves par cm³.
        </div>

        <!-- Matériel nécessaire -->
        <div class="equipment-card bg-gray-50 p-4 rounded-lg">
          <iframe width="560" height="315" src="https://www.youtube.com/embed/aQPfbSP0jx8" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <h4 class="font-semibold mb-2">Matériel requis :</h4>
          <img src="/images/III_unite/2_activites/3.2c.webp" alt="Matériel pour le stade éclosion" class="w-full rounded-lg shadow-md mt-2 mb-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h5 class="font-medium">Matériel de récolte :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Tamis de 0,8 mm</li>
                <li>Bacs de collecte</li>
                <li>Gobelets pour échantillonnage</li>
                <li>Balance de précision</li>
              </ul>
            </div>
            <div>
              <h5 class="font-medium">Matériel de manipulation :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Pinces pour comptage</li>
                <li>Compteur manuel</li>
                <li>Assiette blanche</li>
                <li>Équipements de protection</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="grid gap-6">
          <!-- Étape 1 -->
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4 class="step-title">Tamisage et séparation initiale</h4>
              <p>Retirer les conteneurs d'éclosion les plus anciens (après 6 jours). Tamiser tout le matériau avec un tamis de 0,8 mm. Les petites particules et larves passent à travers, tandis que les plus grandes restent sur le tamis.</p>
              <img src="/images/III_unite/2_activites/c_steps/3.2c_step1.webp" alt="Tamisage des larves" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 2 -->
          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4 class="step-title">Nettoyage des conteneurs</h4>
              <p>Nettoyer les conteneurs d'éclosion avec un nettoyeur haute pression, une brosse à récurer et du détergent. Laisser sécher.</p>
            </div>
          </div>

          <!-- Étape 3 -->
          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4 class="step-title">Échantillonnage</h4>
              <p>Prélever un échantillon aléatoire du mélange de 5-DOL purifié et mesurer deux portions de 2 grammes chacune dans des gobelets.</p>
              <img src="/images/III_unite/2_activites/c_steps/3.2c_step3.webp" alt="Échantillonnage des larves" class="step-image mt-3">
            </div>
          </div>

          <!-- Étape 4 -->
          <div class="step-card">
            <div class="step-number">4</div>
            <div class="step-content">
              <h4 class="step-title">Comptage des échantillons</h4>
              <p>Placer chaque échantillon de 2g sur une assiette et compter manuellement toutes les larves 5-DOL à l'aide de pinces et d'un compteur. Documenter le nombre de larves par 2 grammes.</p>
            </div>
          </div>

          <!-- Étape 5 -->
          <div class="step-card">
            <div class="step-number">5</div>
            <div class="step-content">
              <h4 class="step-title">Pesée totale</h4>
              <p>Peser la masse totale des 5-DOL disponibles dans la boîte. Calculer le nombre total de larves en utilisant les résultats du comptage par 2 grammes.</p>
            </div>
          </div>

          <!-- Étape 6 -->
          <div class="step-card">
            <div class="step-number">6</div>
            <div class="step-content">
              <h4 class="step-title">Préparation des portions</h4>
              <p>En fonction du nombre d'unités d'incubation à mettre en place, préparer des gobelets et les remplir avec le poids nécessaire de mélange 5-DOL pour chaque larvero.</p>
            </div>
          </div>

          <!-- Étape 7 -->
          <div class="step-card">
            <div class="step-number">7</div>
            <div class="step-content">
              <h4 class="step-title">Séparation finale</h4>
              <p>Les 5-DOL restants seront utilisés pour l'élevage des mouches ou éliminés.</p>
            </div>
          </div>

          <!-- Étape 8 -->
          <div class="step-card">
            <div class="step-number">8</div>
            <div class="step-content">
              <h4 class="step-title">Distribution dans les unités</h4>
              <p>Répartir les portions préparées dans les différentes unités d'incubation selon les calculs effectués (600-800 larves par kg de substrat humide).</p>
              <img src="/images/III_unite/2_activites/c_steps/3.2c_step8.webp" alt="Distribution dans les unités" class="step-image mt-3">
            </div>
          </div>
        </div>

        <div class="bg-yellow-50 p-4 rounded-lg mt-6">
          <h4 class="font-semibold text-yellow-800 mb-2">Points de surveillance importants :</h4>
          <ul class="list-disc ml-6 text-yellow-700">
            <li>Porter une blouse de laboratoire et des gants en latex pour manipuler les 5-DOL et les résidus</li>
            <li>Calcul du nombre total de larves : <br>
              <code class="bg-yellow-100 px-2 py-1 rounded">Nombre total = (Masse totale × Nombre dans échantillon) / Masse échantillon</code>
            </li>
            <li>Calcul de la masse nécessaire par larvero : <br>
              <code class="bg-yellow-100 px-2 py-1 rounded">Masse larvero = (Nombre requis × Masse totale) / Nombre total</code>
            </li>
          </ul>
        </div>
      </div>
    `
  },
  {
    id: "nursery-stage",
    title: "Stade nurserie",
    description: `
      <div class="space-y-8">
        <div class="text-gray-700 mb-6">
          Les conteneurs de nurserie permettent d'élever les larves jusqu'au stade pré-pupal, nécessaire pour maintenir la population adulte. Pendant environ deux semaines et demie, 10 000 larves sont élevées dans un Larvero de nurserie, soit une densité de 5 larves par cm².
        </div>

        <!-- Matériel nécessaire -->
        <div class="equipment-card bg-gray-50 p-4 rounded-lg">
          <iframe width="560" height="315" src="https://www.youtube.com/embed/TXTTnEwsdgQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <h4 class="font-semibold mb-2">Matériel requis :</h4>
          <img src="/images/III_unite/2_activites/3.2d.webp" alt="Matériel pour le stade nurserie" class="w-full rounded-lg shadow-md mt-2 mb-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h5 class="font-medium">Conteneurs :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Larvero de nurserie (35x55cm)</li>
                <li>Conteneur de transfert (40x60cm)</li>
                <li>Étiquettes de suivi</li>
              </ul>
            </div>
            <div>
              <h5 class="font-medium">Alimentation :</h5>
              <ul class="list-disc ml-6 text-gray-700">
                <li>Aliment sec pour poulet</li>
                <li>Cocopeat ou son de blé</li>
                <li>Balance de précision</li>
                <li>Matériel de nettoyage</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="grid gap-6">
          <!-- Étape 1 -->
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4 class="step-title">Préparation de la nourriture</h4>
              <p>Préparer 2 kg de nourriture composée de 30% d'aliment sec pour poulet et 70% d'eau. Mélanger jusqu'à obtention d'une mixture homogène.</p>
            </div>
          </div>

          <!-- Étape 2 -->
          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4 class="step-title">Installation des larves</h4>
