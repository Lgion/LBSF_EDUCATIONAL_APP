---
import UserNavAuth from '../auth/UserNavAuth';

const navItems = [
  { href: '/', text: 'Accueil' },
  { href: '/calculator', text: 'BSF Calculator' },
  { href: '/diagnostic', text: 'Diagnostic' },
  { href: '/formations', text: 'Formations' },
  { href: '/boutique', text: 'Boutique' },
  { href: '/colony-manager', text: 'Colony Manager' },
  { href: '/b2b', text: 'Portail B2B' },
];

const chapters = [
  { href: '/chapter1', text: '1. Biologie & Process BSF' },
  { href: '/chapter2', text: '2. Déchets & Collecte' },
  { href: '/chapter3', text: '3. Unités de Production' },
  { href: '/chapter4', text: '4. Modèles d\'Affaires BSF' },
  { href: '/glossary', text: 'Glossaire Scientifique' },
  { href: '/resources', text: 'Ressources & Guides' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-sm transition-all">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Marque -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-600 to-green-700 flex items-center justify-center text-white shadow-md shadow-emerald-700/20 group-hover:scale-105 transition-transform">
          <span class="material-icons text-2xl">eco</span>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-lg text-gray-900 tracking-tight leading-tight group-hover:text-emerald-700 transition-colors">
            ReWaste <span class="text-emerald-600">BSF</span>
          </span>
          <span class="text-[11px] font-medium text-gray-500 uppercase tracking-wider">
            Bioconversion CI
          </span>
        </div>
      </a>

      <!-- Navigation desktop -->
      <div class="hidden xl:flex items-center space-x-1">
        <a
          href="/"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          Accueil
        </a>

        <!-- Menu déroulant Cours & Hub -->
        <div class="relative group">
          <button
            class={`inline-flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              currentPath.startsWith('/chapter') || currentPath === '/glossary' || currentPath === '/resources'
                ? 'bg-emerald-50 text-emerald-800 font-semibold'
                : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
            }`}
          >
            <span>Hub Pédagogique</span>
            <span class="material-icons text-base text-gray-400 group-hover:rotate-180 transition-transform duration-200">expand_more</span>
          </button>
          
          <div class="absolute left-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-gray-100 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="px-3 py-1.5 text-[11px] font-bold text-gray-400 uppercase tracking-wider">
              Cours & Manuels EAWAG/FiBL
            </div>
            {chapters.map(chap => (
              <a
                href={chap.href}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-800 transition-colors"
              >
                {chap.text}
              </a>
            ))}
          </div>
        </div>

        <a
          href="/calculator"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/calculator'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          BSF Calculator
        </a>

        <a
          href="/diagnostic"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/diagnostic'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          Diagnostic
        </a>

        <a
          href="/formations"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/formations'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          Formations
        </a>

        <a
          href="/boutique"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/boutique'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          Boutique 5-DOL
        </a>

        <a
          href="/colony-manager"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/colony-manager'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          <span class="inline-flex items-center gap-1">
            <span>Colony Manager</span>
            <span class="px-1.5 py-0.2 text-[10px] bg-emerald-100 text-emerald-800 rounded font-semibold">Offline</span>
          </span>
        </a>

        <a
          href="/b2b"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
            currentPath === '/b2b'
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-gray-700 hover:text-emerald-700 hover:bg-gray-50'
          }`}
        >
          Portail B2B
        </a>
      </div>

      <!-- Action & Auth Droite -->
      <div class="flex items-center gap-3">
        <!-- Clerk Auth Island -->
        <UserNavAuth client:load />

        <!-- Bouton menu mobile -->
        <button
          id="mobile-menu-button"
          class="xl:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-700 hover:bg-gray-100 focus:outline-none"
          aria-label="Menu principal"
        >
          <span class="material-icons text-2xl">menu</span>
        </button>
      </div>
    </div>

    <!-- Menu mobile -->
    <div id="mobile-menu" class="hidden xl:hidden pb-4 pt-2 border-t border-gray-100 animate-fadeIn">
      <div class="flex flex-col space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`px-4 py-2.5 rounded-lg text-base font-medium transition-colors ${
              currentPath === item.href
                ? 'bg-emerald-50 text-emerald-800 font-semibold'
                : 'text-gray-700 hover:bg-gray-50'
            }`}
          >
            {item.text}
          </a>
        ))}
        
        <div class="pt-2 border-t border-gray-100 mt-2">
          <div class="px-4 py-1 text-xs font-bold text-gray-400 uppercase tracking-wider">
            Cours & Manuels
          </div>
          {chapters.map(chap => (
            <a
              href={chap.href}
              class="block px-4 py-2 text-sm text-gray-600 hover:text-emerald-700 hover:bg-gray-50 rounded-lg"
            >
              {chap.text}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
