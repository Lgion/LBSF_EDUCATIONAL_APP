---
import AdminSidebar from '../components/admin/AdminSidebar';
import UserNavAuth from '../components/auth/UserNavAuth';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description = "Console d'administration ReWaste BSF", currentPath = Astro.url.pathname } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title} | ReWaste Admin</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  </head>
  <body class="min-h-full flex flex-col md:flex-row bg-slate-950 font-sans antialiased text-slate-100">
    <!-- Barre latérale -->
    <AdminSidebar currentPath={currentPath} client:load />

    <!-- Zone de contenu principal -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
      <!-- Barre d'en-tête admin -->
      <header class="h-16 bg-slate-900/80 backdrop-blur-md border-b border-slate-800 px-6 flex items-center justify-between sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Super Admin Connecté
          </span>
          <h1 class="text-sm font-semibold text-slate-200 hidden sm:inline-block">
            {title}
          </h1>
        </div>

        <div class="flex items-center gap-4">
          <UserNavAuth client:load />
        </div>
      </header>

      <!-- Contenu de la page -->
      <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        <slot />
      </main>
    </div>
  </body>
</html>
