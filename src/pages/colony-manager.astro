---
import MainLayout from '../layouts/MainLayout.astro';
import ColonyManagerApp from '../components/colony/ColonyManagerApp';
---

<MainLayout 
  title="My Colony Manager — Outil de Suivi d'Élevage Local-First & Calcul BCR"
  description="Application mobile-first fonctionnant 100% hors-ligne pour la saisie quotidienne des pesées, températures et calcul automatique du BCR."
>
  <div class="container mx-auto px-4 py-10 max-w-7xl">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/70 px-3 py-1 rounded-full mb-3">
        <span class="material-icons text-sm">offline_bolt</span>
        Local-First (Dexie.js IndexedDB)
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight font-heading">
        My Colony Manager : Suivi de Nurserie & Grossissement
      </h1>
      <p class="text-gray-600 mt-2 max-w-3xl text-sm md:text-base">
        Saisissez vos fiches de pesées (log-sheets) sans latence, même sans réseau internet à la ferme. Les données sont sauvegardées en local et synchronisées sur MongoDB Atlas à la reconnexion.
      </p>
    </div>

    <ColonyManagerApp client:only="react" />
  </div>
</MainLayout>
