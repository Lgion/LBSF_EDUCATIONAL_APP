---
import Layout from '../layouts/MainLayout.astro';
import { getPlatformSettings, formatCurrency } from '../lib/settings';
import { getDb } from '../lib/mongodb';
import type { IFormation, ITestimonial, IFaqItem } from '../types/bsf';

export const prerender = false;

// 1. Récupération des paramètres globaux (devise, paiements actifs)
const settings = await getPlatformSettings();
const currency = settings.devise;
const activePayments = settings.payments.filter((p) => p.actif);

// 2. Récupération des formations
let formations: IFormation[] = [];
let testimonials: ITestimonial[] = [];
let faqs: IFaqItem[] = [];

try {
  const db = await getDb();
  formations = (await db.collection('formations').find({}).toArray()) as any;
  testimonials = (await db.collection('testimonials').find({ actif: true }).sort({ ordreAffichage: 1 }).toArray()) as any;
  faqs = (await db.collection('faq').find({ actif: true }).sort({ ordreAffichage: 1 }).toArray()) as any;
} catch (e) {
  console.warn('Erreur chargement SSR MongoDB formations:', e);
}

// Fallback formations si vide
if (!formations || formations.length === 0) {
  formations = [
    {
      code: 'DEBUTANT',
      titre: 'Initiation à l\'Élevage BSF & Bioconversion',
      description: 'Une journée intensive pour comprendre les bases de l\'élevage BSF, la biologie d\'Hermetia illucens et le modèle hybride d\'Unité Centrale.',
      dureeJours: 1,
      prixFcfa: 25000,
      sessionsAvenir: []
    },
    {
      code: 'INTERMEDIAIRE',
      titre: 'Formation Pratique Élevage, Inoculation & Récolte',
      description: 'Formation hands-on au cœur de la ferme : manipulation des 5-DOL, gestion du substrat humide, récolte et blanchiment 90°C.',
      dureeJours: 3,
      prixFcfa: 150000,
      sessionsAvenir: []
    },
    {
      code: 'AVANCE',
      titre: 'Intégration au Réseau de Fermes Satellites',
      description: 'Programme complet de partenariat : approvisionnement hebdomadaire en 5-DOL, monitoring BCR et rachat des récoltes.',
      dureeJours: 5,
      prixFcfa: 450000,
      sessionsAvenir: []
    }
  ];
}

// URL Wave active
const waveConfig = settings.payments.find((p) => p.id === 'WAVE');
const waveBaseUrl = waveConfig?.urlPaiementBase || 'https://pay.wave.com/m/M_ci_hsvjN_ywTw2K/c/ci/';
---

<Layout title="Formations BSF - Développez vos compétences en élevage BSF" description="Découvrez nos formations pratiques et théoriques pour maîtriser l'élevage de Mouches Soldats Noires et la valorisation des déchets organiques.">
  <main class="container mx-auto px-4 py-8 min-h-screen">
    <!-- Hero Banner -->
    <section class="text-center py-12 bg-gradient-to-r from-emerald-800 via-emerald-700 to-green-700 text-white rounded-3xl shadow-xl mb-12 relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-white/5 blur-2xl pointer-events-none"></div>
      <h1 class="text-3xl md:text-5xl font-heading font-extrabold mb-4">Formations BSF</h1>
      <p class="text-base md:text-xl max-w-3xl mx-auto text-emerald-100">
        Développez vos compétences et rejoignez le réseau de production de Mouches Soldats Noires en Côte d'Ivoire.
      </p>
    </section>

    <!-- Pourquoi se former -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8 text-center text-slate-800">
        Pourquoi se former à l'élevage BSF ?
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">schedule</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Gain de temps</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Évitez les erreurs coûteuses et maîtrisez les protocoles d'engraissement dès la première semaine.</p>
        </div>
        
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">school</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Formation pratique</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Pratique directe sur notre pépinière centrale de Songon avec Love Cages et bacs Larveros.</p>
        </div>
        
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">engineering</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Accompagnement</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Suivi agronomique continu, audit de votre installation et calibrage de votre ration de substrat.</p>
        </div>
        
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">hub</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Réseau Satellite</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Accès prioritaire aux livraisons hebdomadaires de 5-DOL calibrées et débouchés garantis.</p>
        </div>
      </div>
    </section>
    
    <!-- Programmes de formation (DYNAMIQUES) -->
    <section class="mb-16 bg-slate-50 p-6 md:p-10 rounded-3xl border border-slate-200/80">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-slate-900">
          Nos programmes de formation
        </h2>
        <p class="text-sm text-slate-500 mt-2">
          Tarifs officiels en {currency.nom} ({currency.symbole}) avec durées configurées par l'Unité Centrale.
        </p>
      </div>
      
      <div class="space-y-6 max-w-4xl mx-auto">
        {formations.map((f) => (
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-md transition-all flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
            <div class="md:w-1/4 w-full">
              <div class="bg-gradient-to-br from-emerald-800 to-green-700 text-white p-5 rounded-2xl text-center shadow-md">
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-200 block mb-1">
                  Niveau {f.code}
                </span>
                <p class="text-2xl font-extrabold mt-1">
                  {f.prixFcfa > 0 ? formatCurrency(f.prixFcfa, currency) : 'Gratuit'}
                </p>
                <div class="mt-2 inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white/20 text-xs font-semibold">
                  <span class="material-icons text-xs">schedule</span>
                  <span>{f.dureeJours} {f.dureeJours > 1 ? 'jours' : 'jour'}</span>
                </div>
              </div>
            </div>

            <div class="md:w-3/4 w-full space-y-3">
              <h3 class="text-xl font-heading font-bold text-slate-900">{f.titre}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{f.description}</p>
              
              <div class="pt-2 flex flex-wrap items-center gap-4 text-xs text-slate-500">
                <span class="flex items-center gap-1 font-semibold text-emerald-700">
                  <span class="material-icons text-sm">location_on</span>
                  Pépinière Songon / Abidjan
                </span>
                <span class="flex items-center gap-1">
                  <span class="material-icons text-sm">verified</span>
                  Attestation ReWaste BSF
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
    
    <!-- Témoignages (DYNAMIQUES) -->
    {testimonials.length > 0 && (
      <section class="mb-16">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-slate-900">
            Témoignages de nos apprenants & partenaires
          </h2>
          <p class="text-sm text-slate-500 mt-2">
            Découvrez comment ils ont transformé leurs exploitations grâce à la bioconversion BSF.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {testimonials.map((t) => (
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-3">
                    {t.avatarUrl ? (
                      <img src={t.avatarUrl} alt={t.nom} class="w-12 h-12 rounded-full object-cover border border-emerald-200" />
                    ) : (
                      <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center">
                        {t.nom.slice(0, 2)}
                      </div>
                    )}
                    <div>
                      <h4 class="font-bold text-slate-900 text-sm">{t.nom}</h4>
                      <p class="text-xs text-slate-500">{t.titreOuMetier} • {t.localisation}</p>
                    </div>
                  </div>

                  <div class="flex text-amber-400">
                    {Array.from({ length: t.noteEtoiles || 5 }).map(() => (
                      <span class="material-icons text-sm">star</span>
                    ))}
                  </div>
                </div>

                <p class="text-xs text-slate-700 italic leading-relaxed">
                  "{t.message}"
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
    
    <!-- Formulaire d'inscription avec Modes de Paiement Conditionnels -->
    <section id="inscription" class="mb-16 bg-gradient-to-r from-emerald-800 to-green-700 text-white p-8 md:p-12 rounded-3xl shadow-xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-2 text-center">
        Réservez votre place en session
      </h2>
      <p class="text-emerald-100 text-sm text-center mb-8 max-w-xl mx-auto">
        Remplissez ce formulaire pour bloquer votre place. Règlement instantané ou validation par notre équipe.
      </p>
      
      <form class="max-w-2xl mx-auto bg-white text-slate-800 p-6 md:p-8 rounded-2xl shadow-lg space-y-4 text-xs">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="nom" class="block font-semibold text-slate-700 mb-1">Nom *</label>
            <input type="text" id="nom" name="nom" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          
          <div>
            <label for="prenom" class="block font-semibold text-slate-700 mb-1">Prénom *</label>
            <input type="text" id="prenom" name="prenom" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="email" class="block font-semibold text-slate-700 mb-1">Email *</label>
            <input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          
          <div>
            <label for="telephone" class="block font-semibold text-slate-700 mb-1">Téléphone (WhatsApp / Wave) *</label>
            <input type="tel" id="telephone" name="telephone" required placeholder="+225 07..." class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
        </div>
        
        <div>
          <label for="formation" class="block font-semibold text-slate-700 mb-1">Programme souhaité *</label>
          <select id="formation" name="formation" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="" disabled selected>Sélectionnez une formation</option>
            {formations.map((f) => (
              <option value={f.code} data-price={f.prixFcfa}>
                {f.titre} ({f.dureeJours} {f.dureeJours > 1 ? 'jours' : 'jour'}) — {formatCurrency(f.prixFcfa, currency)}
              </option>
            ))}
          </select>
        </div>

        {/* Moyens de Paiement DYNAMIQUES (Affichés UNIQUEMENT si activés en admin) */}
        <div>
          <label class="block font-semibold text-slate-700 mb-2">Mode de règlement *</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {activePayments.map((method, idx) => (
              <label class="flex items-center p-3 border border-emerald-300 bg-emerald-50/50 rounded-xl cursor-pointer hover:bg-emerald-50 transition-colors">
                <input
                  type="radio"
                  name="payment_mode"
                  value={method.id}
                  checked={idx === 0}
                  class="text-emerald-600 focus:ring-emerald-500 mr-2.5"
                />
                <div>
                  <span class="font-bold text-emerald-950 text-xs block">{method.nomAffiche}</span>
                  <span class="text-[10px] text-emerald-700">{method.badge || method.instructions}</span>
                </div>
              </label>
            ))}

            <label class="flex items-center p-3 border border-slate-200 bg-white rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
              <input type="radio" name="payment_mode" value="ESPECES" class="text-emerald-600 focus:ring-emerald-500 mr-2.5" />
              <div>
                <span class="font-bold text-slate-900 text-xs block">Règlement sur place</span>
                <span class="text-[10px] text-slate-500">Espèces au centre de Songon</span>
              </div>
            </label>
          </div>
        </div>

        <div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-md flex items-center justify-center gap-2 text-sm mt-4"
          >
            <span class="material-icons text-base">send</span>
            <span>Confirmer ma réservation</span>
          </button>
        </div>
      </form>
    </section>
    
    <!-- FAQ (DYNAMIQUE) -->
    {faqs.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8 text-center text-slate-900">
          Questions fréquentes
        </h2>
        
        <div class="space-y-4 max-w-3xl mx-auto">
          {faqs.map((item) => (
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
              <h3 class="text-base font-bold text-slate-900 mb-2">{item.question}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{item.reponse}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<script define:vars={{ waveBaseUrl }}>
  const form = document.querySelector('form');
  const formationSelect = document.getElementById('formation');

  form?.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(form);
    const nom = formData.get('nom');
    const telephone = formData.get('telephone');
    const selectedOption = formationSelect.options[formationSelect.selectedIndex];
    const price = Number(selectedOption.getAttribute('data-price') || 0);
    const paymentMode = formData.get('payment_mode');

    if (paymentMode === 'WAVE' && price > 0) {
      const orderRef = `FORM_${Date.now().toString().slice(-6)}`;
      const cleanUrl = waveBaseUrl.includes('?') 
        ? `${waveBaseUrl}&amount=${price}&memo=${encodeURIComponent('REWASTE_' + orderRef + '_' + String(nom).replace(/\s+/g, ''))}`
        : `${waveBaseUrl}?amount=${price}&memo=${encodeURIComponent('REWASTE_' + orderRef + '_' + String(nom).replace(/\s+/g, ''))}`;
      
      alert(`Merci ${nom} ! Vous allez être redirigé vers Wave Côte d'Ivoire pour régler votre inscription de ${price.toLocaleString('fr-FR')} FCFA.`);
      window.open(cleanUrl, '_blank');
    } else {
      alert(`Merci ${nom} ! Votre demande d'inscription a été enregistrée. Notre équipe à Songon vous contactera sur WhatsApp au ${telephone}.`);
    }
  });
</script>
