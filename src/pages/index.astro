---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Accueil">
  <!-- Hero Section -->
  <section class="bg-primary text-white py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">
          Formation à la Production de Larves de Mouches Soldats Noires
        </h1>
        <p class="text-xl mb-8">
          Découvrez comment transformer les déchets organiques en ressources précieuses grâce aux larves BSF
        </p>
        <a
          href="/chapter1"
          class="inline-flex items-center bg-white text-primary px-6 py-3 rounded-md font-medium hover:bg-gray-100 transition-colors duration-200"
        >
          Commencer la formation
          <span class="material-icons ml-2">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Aperçu des chapitres -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-heading font-semibold text-center mb-12">
        Programme de la formation
      </h2>

      <div class="text-center mb-10 max-w-3xl mx-auto">
        <p class="text-xl text-gray-700 mb-6">
          Notre formation complète vous guide à travers toutes les étapes nécessaires pour maîtriser l'élevage BSF, de la théorie à la pratique opérationnelle.
        </p>
        <a href="/formations" class="text-primary hover:underline font-medium">Découvrir notre programme détaillé →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Bénéfice 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-green-500 transform transition hover:scale-105">
          <div class="flex items-center mb-4">
            <span class="material-icons text-3xl text-green-500 mr-3">eco</span>
            <h3 class="text-xl font-semibold">Valorisez vos déchets</h3>
          </div>
          <p class="text-gray-600">
            Transformez jusqu'à 80% de vos déchets organiques en ressources précieuses et réduisez votre empreinte écologique tout en générant des revenus supplémentaires.
          </p>
        </div>

        <!-- Bénéfice 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-primary transform transition hover:scale-105">
          <div class="flex items-center mb-4">
            <span class="material-icons text-3xl text-primary mr-3">trending_up</span>
            <h3 class="text-xl font-semibold">Créez votre business</h3>
          </div>
          <p class="text-gray-600">
            Lancez une activité rentable avec un investissement initial modéré. Nos formateurs vous accompagnent dans la conception de votre projet d'entreprise BSF sur mesure.
          </p>
        </div>

        <!-- Bénéfice 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-yellow-500 transform transition hover:scale-105">
          <div class="flex items-center mb-4">
            <span class="material-icons text-3xl text-yellow-500 mr-3">psychology</span>
            <h3 class="text-xl font-semibold">Expertise pratique</h3>
          </div>
          <p class="text-gray-600">
            Bénéficiez d'un savoir-faire éprouvé et évitez les erreurs coûteuses. Notre approche hands-on vous permet de maîtriser rapidement toutes les techniques d'élevage.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/formations#inscription" class="bg-secondary hover:bg-secondary-dark text-white font-bold py-4 px-8 rounded-full text-lg inline-flex items-center transition-colors">
          Je m'inscris à la formation
          <span class="material-icons ml-2">arrow_forward</span>
        </a>
        <p class="text-gray-500 mt-4">Places limitées à 12 participants par session</p>
      </div>
    </div>
  </section>

  <!-- Caractéristiques -->
  <section class="bg-gray-50 py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-heading font-semibold text-center mb-12">
        Pourquoi cette formation ?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <span class="material-icons text-4xl text-primary mb-4">
            eco
          </span>
          <h3 class="text-xl font-heading font-semibold mb-2">
            Solution écologique
          </h3>
          <p class="text-gray-600">
            Transformez les déchets organiques en ressources valorisables
          </p>
        </div>

        <div class="text-center">
          <span class="material-icons text-4xl text-primary mb-4">
            psychology
          </span>
          <h3 class="text-xl font-heading font-semibold mb-2">
            Formation pratique
          </h3>
          <p class="text-gray-600">
            Apprenez les techniques concrètes de production
          </p>
        </div>

        <div class="text-center">
          <span class="material-icons text-4xl text-primary mb-4">
            trending_up
          </span>
          <h3 class="text-xl font-heading font-semibold mb-2">
            Opportunité commerciale
          </h3>
          <p class="text-gray-600">
            Développez une activité économique viable
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Formation En Présentiel -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="bg-primary-light rounded-lg shadow-lg overflow-hidden">
        <div class="md:flex">
          <div class="md:w-2/3 p-8 md:p-12 text-white">
            <h2 class="text-3xl font-bold mb-4">Formations BSF en présentiel</h2>
            <p class="text-xl mb-6">Vous souhaitez aller plus loin et lancer votre propre projet d'élevage BSF ?</p>
            <p class="mb-8">Nos formations pratiques et intensives vous permettent d'acquérir toutes les compétences nécessaires pour réussir votre installation, de l'initiation d'une journée à l'accompagnement sur mesure pour votre projet d'entreprise.</p>
            <div class="space-y-3 mb-8">
              <div class="flex items-start">
                <span class="material-icons text-white mr-2 mt-1">check_circle</span>
                <p>Formation initiale (1 jour) - Découvrez les bases de l'élevage BSF</p>
              </div>
              <div class="flex items-start">
                <span class="material-icons text-white mr-2 mt-1">check_circle</span>
                <p>Formation pratique (3 jours) - Maîtrisez toutes les étapes techniques</p>
              </div>
              <div class="flex items-start">
                <span class="material-icons text-white mr-2 mt-1">check_circle</span>
                <p>Formation business (5 jours) - Développez votre projet commercial</p>
              </div>
            </div>
            <a href="/formations" class="inline-flex items-center bg-white text-primary px-6 py-3 rounded-md font-medium hover:bg-gray-100 transition-colors duration-200">
              Découvrir nos formations
              <span class="material-icons ml-2">arrow_forward</span>
            </a>
          </div>
          <div class="md:w-1/3 bg-primary flex items-center justify-center p-8">
            <!-- <img src="/images/formation-bsf.webp" alt="Formation BSF" class="rounded-lg shadow-lg" onerror="this.src='/images/III_unite/1_overview/3.1.1.webp'"> -->
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
